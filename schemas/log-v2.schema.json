{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stefan-van-dijk.github.io/log/schemas/log-v2.schema.json",
  "title": "Log export v2",
  "description": "Gecombineerde, herstelbare export van de Log-app.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "export_kind",
    "generated_at",
    "app",
    "counts",
    "data",
    "recovery"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schema": {
      "const": "log.v2"
    },
    "schema_version": {
      "const": 2
    },
    "export_kind": {
      "const": "complete_backup"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "app": {
      "type": "object",
      "required": [
        "name",
        "build"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "Log"
        },
        "build": {
          "type": "string"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "data": {
      "type": "object",
      "required": [
        "settings",
        "catalog",
        "activities",
        "relationships",
        "track_points",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "settings": {
          "type": "object",
          "required": [
            "mobility",
            "time"
          ],
          "additionalProperties": false,
          "properties": {
            "mobility": {
              "type": "object"
            },
            "time": {
              "type": "object"
            }
          }
        },
        "catalog": {
          "type": "object",
          "required": [
            "locations",
            "tasks",
            "people",
            "departments"
          ],
          "additionalProperties": false,
          "properties": {
            "locations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/location"
              }
            },
            "tasks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/task"
              }
            },
            "people": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/person"
              }
            },
            "departments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/department"
              }
            }
          }
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activity"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "track_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trackPoint"
          }
        },
        "state": {
          "type": "object",
          "required": [
            "active_activity_ids"
          ],
          "properties": {
            "active_activity_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      }
    },
    "recovery": {
      "type": "object",
      "required": [
        "format",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "log.internal.v1"
        },
        "sources": {
          "type": "object",
          "required": [
            "kilometerregistratie",
            "tijdsregistratie",
            "identiteiten"
          ],
          "additionalProperties": false,
          "properties": {
            "kilometerregistratie": {
              "$ref": "#/$defs/recoverySource"
            },
            "tijdsregistratie": {
              "$ref": "#/$defs/recoverySource"
            },
            "identiteiten": {
              "$ref": "#/$defs/recoverySource"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "baseEntity": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "location": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEntity"
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "location"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "coordinates": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/coordinates"
                }
              ]
            }
          }
        }
      ]
    },
    "task": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEntity"
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "task_type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "task"
            },
            "task_type": {
              "enum": [
                "theme",
                "subtheme"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "person": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEntity"
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "person"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "department": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEntity"
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "department"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "activity": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEntity"
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "activity_type",
            "status"
          ],
          "properties": {
            "type": {
              "const": "activity"
            },
            "activity_type": {
              "enum": [
                "trip",
                "trip_event",
                "time"
              ]
            },
            "status": {
              "enum": [
                "active",
                "completed"
              ]
            },
            "started_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "ended_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        }
      ]
    },
    "relationship": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEntity"
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "relationship_type",
            "from_id",
            "to_id"
          ],
          "properties": {
            "type": {
              "const": "relationship"
            },
            "relationship_type": {
              "type": "string"
            },
            "from_id": {
              "type": "string"
            },
            "to_id": {
              "type": "string"
            }
          }
        }
      ]
    },
    "trackPoint": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEntity"
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "activity_id",
            "recorded_at",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "track_point"
            },
            "activity_id": {
              "type": "string"
            },
            "recorded_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "coordinates": {
              "$ref": "#/$defs/coordinates"
            }
          }
        }
      ]
    },
    "coordinates": {
      "type": "object",
      "required": [
        "latitude",
        "longitude"
      ],
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "recoverySource": {
      "type": "object",
      "required": [
        "storage_key",
        "present",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "storage_key": {
          "type": "string"
        },
        "present": {
          "type": "boolean"
        },
        "data": {}
      }
    }
  }
}
